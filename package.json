{
  "name": "leonx-os",
  "private": true,
  "version": "0.9.3",
  "description": "LEONX OS — LEONX Metal iç kullanım proje, metraj ve teklif yönetim sistemi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run test && npm run build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs dist",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "node e2e/app.e2e.mjs",
    "bench:cad": "vitest run src/cad/bench --reporter=verbose"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tesseract.js-data/tur": "1.0.0",
    "fflate": "^0.8.3",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
